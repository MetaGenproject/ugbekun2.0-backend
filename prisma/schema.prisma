// ─────────────────────────────────────────────────────────────────────────────
// INVENTORY MANAGEMENT MODULE
// ─────────────────────────────────────────────────────────────────────────────

model InventoryItem {
  id                Int      @id @default(autoincrement())
  branchId          Int
  branch            Branch   @relation(fields: [branchId], references: [id])
  name              String
  category          String   @default("General") // Uniforms, Books, Stationery, Sports, General
  unit              String   @default("Pcs") // Pcs, Packs, Pairs, Boxes
  unitCost          Float    @default(0.0) // Cost price per unit
  unitPrice         Float    @default(0.0) // Selling price per unit
  totalPurchasedInt Int      @default(0) // Total quantity restocked/purchased
  totalSoldInt      Int      @default(0) // Total quantity sold/issued
  quantityBalance   Int      @default(0) // Current balance stock
  reorderLevel      Int      @default(5) // Reorder threshold alert level
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transactions      InventoryTransaction[]

  @@map("inventory_items")
}

model InventoryTransaction {
  id          Int           @id @default(autoincrement())
  itemId      Int
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type        String        // "PURCHASE" or "SALE"
  quantity    Int
  unitPrice   Float
  totalAmount Float
  referenceNo String?
  notes       String?
  issuedTo    String?       // Student / Staff / Customer name
  createdAt   DateTime      @default(now())

  @@map("inventory_transactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// TEACHER AUDIT ACTIVITIES & REMINDERS
// ─────────────────────────────────────────────────────────────────────────────

model TeacherActivity {
  id        Int      @id @default(autoincrement())
  branchId  Int      @map("branch_id")
  teacherId Int      @map("teacher_id")
  activity  String
  type      String   @default("GENERAL") // HOMEWORK, EXAM, SCORES, ATTENDANCE, LESSON
  createdAt DateTime @default(now()) @map("created_at")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@index([teacherId])
  @@index([branchId])
  @@map("teacher_activities")
}

model TeacherReminder {
  id        Int      @id @default(autoincrement())
  teacherId Int      @map("teacher_id")
  text      String
  subtext   String?
  done      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("teacher_reminders")
}

