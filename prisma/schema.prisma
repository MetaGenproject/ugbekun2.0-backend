// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// BRANCH (SCHOOL)
// Each branch represents a physical school location managed under the SaaS
// platform. All students, parents, teachers and configurations are scoped
// to a branch. Migrated from legacy branch_id integer references.
// ─────────────────────────────────────────────────────────────────────────────

model Branch {
  id                   Int       @id @default(autoincrement())
  name                 String
  code                 String?   @unique // e.g. "MTGA", "DIV", "FSP"
  address              String?   @db.Text
  city                 String?
  state                String?
  phone                String?
  email                String?
  logo                 String?
  // Branding assets shown in tenant pages (admin requested)
  systemLogo           String?
  textLogo             String?
  printingLogo         String?
  reportCardLogo       String?
  adminName            String?
  adminGender          String?
  active               Boolean   @default(true)
  idCardPrimaryColor   String?   @default("#1b5e20") @map("id_card_primary_color")
  idCardSecondaryColor String?   @default("#2e7d32") @map("id_card_secondary_color")
  idCardLayoutType     String    @default("classic") @map("id_card_layout_type")
  // Domain and white-label settings
  subdomain                String?   @unique
  customDomain             String?   @unique @map("custom_domain")
  domainStatus             String    @default("PENDING_VERIFICATION") @map("domain_status")
  domainVerificationToken  String?   @map("domain_verification_token")
  domainDnsTarget          String?   @default("cname.ugbekun.edu.ng") @map("domain_dns_target")
  sslStatus                String    @default("PENDING") @map("ssl_status")
  domainVerifiedAt         DateTime? @map("domain_verified_at")

  createdAt            DateTime  @default(now())
  updatedAt            DateTime? @updatedAt

  landingPage          SchoolLandingPage?

  // Relations — every entity scoped to this branch
  students               Student[]
  parents                Parent[]
  teachers               Teacher[]
  teacherAllocations     TeacherAllocation[]
  teacherNotes           TeacherNote[]
  frontCmsTeachers       FrontCmsTeacher[]
  onlineAdmissions       OnlineAdmission[]
  frontCmsAdmissions     FrontCmsAdmission[]
  onlineAdmissionFields  OnlineAdmissionField[]
  studentAdmissionFields StudentAdmissionField[]
  subscriptions          BranchSubscription[]
  idCards                IdCard[]
  certificates           Certificate[]
  feeTypes               FeeType[]
  feeAssignments         FeeAssignment[]
  invoices               Invoice[]
  payments               Payment[]
  libraryResources       LibraryResource[]
  libraryIssues          LibraryIssue[]
  feeGroups              FeeGroup[]
  voucherHeads           VoucherHead[]
  officeTransactions     OfficeTransaction[]
  schoolBank             SchoolBank?
  systemSetting          SystemSetting?
  gamificationConfig     GamificationConfig?
  inventoryItems         InventoryItem[]

  classes         Class[]
  sections        Section[]
  subjects        Subject[]
  siblingRequests ParentSiblingRequest[]
  parentMessages  ParentMessage[]
  studentMessages StudentMessage[]
  teacherActivities TeacherActivity[]
  triviaArenas    TriviaArena[]
  staffRoles      StaffRole[]
  timetableSlots  TimetableSlot[]
  evaluationMatrices EvaluationMatrix[]
  examHalls       ExamHall[]
  examScheduleSlots ExamScheduleSlot[]
  questionGroups  QuestionGroup[]
  cbtDistributions CbtDistribution[]
  staffAttendances StaffAttendance[]
  leaveCategories LeaveCategory[]
  leaveRequests   LeaveRequest[]
  payrollComponents PayrollComponent[]
  payrollRuns     PayrollRun[]
  payslips        Payslip[]
  salaryAdvances  SalaryAdvance[]
  staffConducts   StaffConduct[]
  employmentLetters EmploymentLetter[]

  @@map("branches")
}

// ─────────────────────────────────────────────────────────────────────────────
// SAAS SUBSCRIPTION PLANS
// Public marketing plans (Starter, Professional, Basic Plus, etc.)
// Fused with legacy SaaS onboarding: plan name, duration, total cost.
// ─────────────────────────────────────────────────────────────────────────────

model SubscriptionPlan {
  id             Int       @id @default(autoincrement())
  slug           String    @unique
  name           String
  description    String?   @db.Text
  priceMonthly   Decimal   @db.Decimal(18, 2)
  durationMonths Int       @default(3)
  totalCost      Decimal   @db.Decimal(18, 2)
  currency       String    @default("NGN")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt

  subscriptions BranchSubscription[]

  @@map("subscription_plans")
}

// ─────────────────────────────────────────────────────────────────────────────
// BRANCH SUBSCRIPTION
// Active or pending subscription for a school (branch) on the SaaS platform.
// ─────────────────────────────────────────────────────────────────────────────

model BranchSubscription {
  id            Int       @id @default(autoincrement())
  startDate     DateTime
  expiryDate    DateTime
  totalCost     Decimal   @db.Decimal(18, 2)
  paymentStatus String    @default("pending") // pending | paid | failed
  message       String?   @db.Text
  termsAccepted Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  planId Int
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("branch_subscriptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH / CREDENTIALS
// Mapped from legacy: login_credential
// Role codes — VERIFIED against ugbekunc_Saas (2).sql data:
//   1=Superadmin/Master (1 global user), 2=Branch Admin (per school), 3=Teacher,
//   4=Accountant, 6=Parent, 7=Student, 8=Receptionist, 9=Proprietor,
//   12=Librarian, 13=Other Staff
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           Int       @id // Preserve legacy login_credential.id
  legacyUserId Int? // login_credential.user_id — the profile ID in the domain
  username     String    @unique
  password     String // Bcrypt-compatible hash — directly migrated
  rawPassword  String?   @map("raw_password")
  role         Int // Legacy tinyint role code
  photo        String?   @map("photo")
  active       Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt

  // Optional profile links based on role
  student Student? @relation("UserStudent")
  parent  Parent?  @relation("UserParent")
  teacher Teacher? @relation("UserTeacher")
  idCards IdCard[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// PARENT / GUARDIAN
// Mapped from legacy: parent
// Note: legacy active 0 = active, 1 = deactivated — inverted during ETL
// ─────────────────────────────────────────────────────────────────────────────

model Parent {
  id          Int       @id // Preserve legacy parent.id
  name        String?
  relation    String?
  fatherName  String?
  motherName  String?
  occupation  String?
  income      String?
  education   String?
  email       String?
  mobileno    String?
  address     String?   @db.Text
  city        String?
  state       String?
  photo       String?
  facebookUrl String?
  linkedinUrl String?
  twitterUrl  String?
  active      Boolean   @default(true) // ETL: legacy 0→true, 1→false
  createdAt   DateTime  @default(now())
  updatedAt   DateTime?

  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id])

  students Student[]

  userId          Int?                   @unique
  user            User?                  @relation("UserParent", fields: [userId], references: [id])
  siblingRequests ParentSiblingRequest[]
  messages        ParentMessage[]

  @@map("parents")
}

// ─────────────────────────────────────────────────────────────────────────────
// STUDENT
// Mapped from legacy: student
// Date fields stored as varchar in legacy — parsed to DateTime? during ETL
// ─────────────────────────────────────────────────────────────────────────────

model Student {
  id               Int       @id // Preserve legacy student.id
  registerNo       String?   @unique
  admissionDate    DateTime? // ETL: parse from varchar, null if invalid
  firstName        String?
  lastName         String?
  gender           String?
  birthday         DateTime? // ETL: parse from varchar, null if invalid
  religion         String?
  caste            String?
  bloodGroup       String?
  motherTongue     String?
  currentAddress   String?   @db.Text
  permanentAddress String?   @db.Text
  city             String?
  state            String?
  mobileno         String?
  categoryId       Int       @default(0)
  email            String?
  routeId          Int       @default(0)
  stoppagePointId  Int?
  vehicleId        Int?
  hostelId         Int       @default(0)
  roomId           Int       @default(0)
  previousDetails  String?   @db.Text
  photo            String?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime?

  parentId Int?
  parent   Parent? @relation(fields: [parentId], references: [id])

  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id])

  userId Int?  @unique
  user   User? @relation("UserStudent", fields: [userId], references: [id])

  idCardToken           String?                @unique @map("id_card_token")
  idCardStatus          String                 @default("active") @map("id_card_status")
  enrolls               Enroll[]
  marks                 Mark[]
  attendances           Attendance[]
  commentaries          StudentCommentary[]
  onlineExamSubmissions OnlineExamSubmission[]
  homeworkSubmissions   HomeworkSubmission[]
  montessoriAssessments MontessoriAssessment[]
  idCards               IdCard[]
  certificates          Certificate[]
  invoices              Invoice[]
  xp                    Int                    @default(0) @map("xp")
  triviaStreak          StudentTriviaStreak?
  triviaSubmissions     TriviaSubmission[]
  badges                StudentBadge[]
  attritionRisk         StudentAttritionRisk?
  wallet                StudentWallet?
  arenaParticipants     TriviaArenaParticipant[]
  aiSessions            AiCompanionSession[]
  parentMessages        ParentMessage[]
  studentMessages       StudentMessage[]
  studentReminders       StudentReminder[]

  @@map("students")
}

// ─────────────────────────────────────────────────────────────────────────────
// TEACHER
// Synthesised from: login_credential (role=3) + teacher_allocation.teacher_id
// The legacy system has no dedicated teacher profile table — Teacher records
// are constructed from credential usernames and allocation data during ETL.
// ─────────────────────────────────────────────────────────────────────────────

model Teacher {
  id        Int       @id // legacy user_id for teacher credentials
  name      String // Derived from login_credential.username
  email     String?
  phone          String?
  photo          String?
  qualifications String?   @db.Text
  houseAddress   String?   @db.Text
  department     String?
  bankName       String?
  accountNumber  String?
  accountName    String?
  weeklyPeriods  Int?      @default(18) @map("weekly_periods")
  active         Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime?

  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id])

  allocations    TeacherAllocation[]
  notes          TeacherNote[]
  cmsPages       FrontCmsTeacher[]
  subjectAssigns SubjectAssign[]
  lessonPlans    LessonPlan[]
  points         Int                 @default(0) @map("points")

  userId Int?  @unique
  user   User? @relation("UserTeacher", fields: [userId], references: [id])
  
  interventionAlerts InterventionAlert[]
  timetableSlots     TimetableSlot[]
  examHalls          ExamHall[]
  examScheduleSlots  ExamScheduleSlot[]
  staffAttendances   StaffAttendance[]
  activities         TeacherActivity[]
  reminders          TeacherReminder[]

  @@map("teachers")
}

// ─────────────────────────────────────────────────────────────────────────────
// TEACHER ALLOCATION
// Mapped from legacy: teacher_allocation
// ─────────────────────────────────────────────────────────────────────────────

model TeacherAllocation {
  id        Int @id // Preserve legacy teacher_allocation.id
  classId   Int
  sectionId Int
  sessionId Int

  teacherId Int
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id])

  class   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  @@map("teacher_allocations")
}

// ─────────────────────────────────────────────────────────────────────────────
// TEACHER NOTES
// Mapped from legacy: teacher_note
// ─────────────────────────────────────────────────────────────────────────────

model TeacherNote {
  id          Int       @id // Preserve legacy teacher_note.id
  title       String    @db.Text
  description String    @db.Text
  fileName    String    @db.Text
  encName     String    @db.Text
  typeId      Int
  classId     String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime?

  teacherId Int
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  @@map("teacher_notes")
}

// ─────────────────────────────────────────────────────────────────────────────
// FRONT CMS — TEACHER PAGE CONFIG
// Mapped from legacy: front_cms_teachers
// One CMS config per branch for the Teachers landing page
// ─────────────────────────────────────────────────────────────────────────────

model FrontCmsTeacher {
  id              Int     @id
  pageTitle       String?
  bannerImage     String?
  metaDescription String  @default("") @db.Text
  metaKeyword     String  @default("") @db.Text

  // Which teacher is "featured" on this branch's CMS teacher page (optional)
  teacherId Int?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId]) // One CMS teacher page per branch
  @@map("front_cms_teachers")
}

// ─────────────────────────────────────────────────────────────────────────────
// ONLINE ADMISSIONS
// Mapped from legacy: online_admission
// ─────────────────────────────────────────────────────────────────────────────

model OnlineAdmission {
  id                    Int       @id
  referenceNo           String?
  firstName             String
  lastName              String?
  gender                String?
  birthday              DateTime? // ETL: parse varchar, null if invalid
  religion              String?
  caste                 String?
  bloodGroup            String?
  mobileNo              String?
  motherTongue          String?
  presentAddress        String?   @db.Text
  permanentAddress      String?   @db.Text
  admissionDate         DateTime? // ETL: parse varchar, null if invalid
  city                  String?
  state                 String?
  studentPhoto          String?
  categoryId            String?
  email                 String?
  previousSchoolDetails String?   @db.Text
  guardianName          String?
  guardianRelation      String?
  fatherName            String?
  motherName            String?
  grdOccupation         String?
  grdIncome             String?
  grdEducation          String?
  grdEmail              String?
  grdMobileNo           String?
  grdAddress            String?   @db.Text
  grdCity               String?
  grdState              String?
  grdPhoto              String?
  status                Int       @default(1)
  rejectionReason       String?   @db.Text
  reviewNotes           String?   @db.Text
  paymentStatus         Int       @default(0)
  paymentAmount         Decimal   @default(0) @db.Decimal(18, 2)
  paymentDetails        String    @default("") @db.Text
  classId               Int
  sectionId             String?
  applyDate             DateTime
  doc                   String?
  createdDate           DateTime?

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  @@map("online_admissions")
}

// ─────────────────────────────────────────────────────────────────────────────
// FRONT CMS — ADMISSIONS PAGE CONFIG
// Mapped from legacy: front_cms_admission
// ─────────────────────────────────────────────────────────────────────────────

model FrontCmsAdmission {
  id                         Int     @id
  title                      String?
  description                String? @db.Text
  pageTitle                  String?
  termsConditionsTitle       String?
  termsConditionsDescription String  @default("") @db.Text
  feeElements                String? @db.Text
  bannerImage                String?
  metaDescription            String  @default("") @db.Text
  metaKeyword                String  @default("") @db.Text
  applicationFormName        String?
  applicationFormFile        String?

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId]) // One CMS admission page per branch
  @@map("front_cms_admissions")
}

// ─────────────────────────────────────────────────────────────────────────────
// ONLINE ADMISSION FORM FIELD CONFIG
// Mapped from legacy: online_admission_fields
// ─────────────────────────────────────────────────────────────────────────────

model OnlineAdmissionField {
  id       Int     @id
  fieldsId Int
  status   Boolean @default(true)
  required Boolean @default(false)
  system   Boolean @default(true)

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  @@map("online_admission_fields")
}

// ─────────────────────────────────────────────────────────────────────────────
// STUDENT ADMISSION FIELD CONFIG
// Mapped from legacy: student_admission_fields
// ─────────────────────────────────────────────────────────────────────────────

model StudentAdmissionField {
  id       Int     @id
  fieldsId Int
  status   Boolean @default(true)
  required Boolean @default(false)
  system   Boolean @default(true)

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  @@map("student_admission_fields")
}

// ─────────────────────────────────────────────────────────────────────────────
// SCHOOL YEAR / ACADEMIC SESSIONS
// Mapped from legacy: schoolyear
// ─────────────────────────────────────────────────────────────────────────────

model SchoolYear {
  id         Int       @id @default(autoincrement())
  schoolYear String    @map("school_year")
  createdBy  Int       @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@map("schoolyear")
}

// ─────────────────────────────────────────────────────────────────────────────
// GLOBAL SETTINGS
// Mapped from legacy: global_settings
// ─────────────────────────────────────────────────────────────────────────────

model GlobalSettings {
  id            Int      @id @default(autoincrement())
  instituteName String   @map("institute_name")
  sessionId     Int      @map("session_id") // Currently active session ID
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("global_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// NEW ACADEMIC CONFIGURATION MODELS
// ─────────────────────────────────────────────────────────────────────────────

model Class {
  id                    Int                    @id @default(autoincrement())
  name                  String
  nameNumeric           String                 @map("name_numeric")
  isEcd                 Boolean                @default(false) @map("is_ecd")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime?              @updatedAt @map("updated_at")
  branchId              Int?                   @map("branch_id")
  branch                Branch?                @relation(fields: [branchId], references: [id])
  enrolls               Enroll[]
  sections              SectionsAllocation[]
  subjects              SubjectAssign[]
  marks                 Mark[]
  attendances           Attendance[]
  teacherAllocations    TeacherAllocation[]
  onlineExams           OnlineExam[]
  homeworks             Homework[]
  montessoriAssessments MontessoriAssessment[]
  siblingRequests       ParentSiblingRequest[]
  feeAssignments        FeeAssignment[]
  lessonPlans           LessonPlan[]
  questionBankItems     QuestionBank[]
  timetableSlots        TimetableSlot[]
  examScheduleSlots     ExamScheduleSlot[]

  evaluationMatrixId    Int?              @map("evaluation_matrix_id")
  evaluationMatrix      EvaluationMatrix? @relation(fields: [evaluationMatrixId], references: [id])

  cbtDistributions      CbtDistribution[]

  @@index([branchId])
  @@map("class")
}

model Section {
  id                    Int                    @id @default(autoincrement())
  name                  String
  capacity              String?
  branchId              Int?                   @map("branch_id")
  branch                Branch?                @relation(fields: [branchId], references: [id])
  enrolls               Enroll[]
  classes               SectionsAllocation[]
  subjects              SubjectAssign[]
  marks                 Mark[]
  attendances           Attendance[]
  teacherAllocations    TeacherAllocation[]
  montessoriAssessments MontessoriAssessment[]
  siblingRequests       ParentSiblingRequest[]
  timetableSlots        TimetableSlot[]
  examScheduleSlots     ExamScheduleSlot[]

  cbtDistributions      CbtDistribution[]

  @@index([branchId])
  @@map("section")
}

model SectionsAllocation {
  id        Int     @id @default(autoincrement())
  classId   Int     @map("class_id")
  sectionId Int     @map("section_id")
  class     Class   @relation(fields: [classId], references: [id])
  section   Section @relation(fields: [sectionId], references: [id])

  @@unique([classId, sectionId])
  @@map("sections_allocation")
}

model Subject {
  id            Int             @id @default(autoincrement())
  name          String
  subjectCode   String          @map("subject_code")
  subjectType   String          @map("subject_type")
  subjectAuthor String          @map("subject_author")
  branchId      Int?            @map("branch_id")
  branch        Branch?         @relation(fields: [branchId], references: [id])
  assigns           SubjectAssign[]
  marks             Mark[]
  onlineExams       OnlineExam[]
  homeworks         Homework[]
  lessonPlans       LessonPlan[]
  questionBankItems QuestionBank[]
  timetableSlots    TimetableSlot[]
  examScheduleSlots ExamScheduleSlot[]

  questionGroups    QuestionGroup[]
  cbtDistributions  CbtDistribution[]

  @@index([branchId])
  @@map("subject")
}

model SubjectAssign {
  id        Int       @id @default(autoincrement())
  classId   Int       @map("class_id")
  sectionId Int       @map("section_id")
  subjectId Int       @map("subject_id")
  teacherId Int       @map("teacher_id")
  branchId  Int       @map("branch_id")
  sessionId Int       @map("session_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  class   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@index([branchId, sessionId])
  @@index([classId, sectionId])
  @@map("subject_assign")
}

model Enroll {
  id           Int       @id @default(autoincrement())
  studentId    Int       @map("student_id")
  classId      Int       @map("class_id")
  sectionId    Int       @map("section_id")
  roll         Int       @default(0)
  sessionId    Int       @map("session_id")
  defaultLogin Int       @default(0) @map("default_login")
  branchId     Int       @map("branch_id")
  isAlumni     Int       @default(0) @map("is_alumni")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  @@index([branchId, sessionId])
  @@index([studentId])
  @@map("enroll")
}

model Exam {
  id                    Int                    @id @default(autoincrement())
  name                  String
  termId                Int?                   @map("term_id")
  typeId                Int                    @map("type_id")
  sessionId             Int                    @map("session_id")
  branchId              Int?                   @map("branch_id")
  remark                String
  markDistribution      String                 @map("mark_distribution")
  status                Int                    @default(1)
  publishResult         Int                    @default(1) @map("publish_result")
  resumptionDate        DateTime?              @map("resumption_date")
  rankGenerated         Int                    @default(0) @map("rank_generated")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime?              @updatedAt @map("updated_at")
  marks                 Mark[]
  montessoriAssessments MontessoriAssessment[]

  @@index([branchId, sessionId])
  @@map("exam")
}

model ExamMarkDistribution {
  id       Int    @id @default(autoincrement())
  name     String
  branchId Int?   @map("branch_id")

  @@index([branchId])
  @@map("exam_mark_distribution")
}

model Mark {
  id        Int     @id @default(autoincrement())
  studentId Int     @map("student_id")
  subjectId Int     @map("subject_id")
  classId   Int     @map("class_id")
  sectionId Int     @map("section_id")
  examId    Int     @map("exam_id")
  mark      String? @map("mark")
  cbtMark   String? @map("cbt_mark")
  absent    String? @map("absent")
  sessionId Int     @map("session_id")
  branchId  Int?    @map("branch_id")

  student Student @relation(fields: [studentId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])
  exam    Exam    @relation(fields: [examId], references: [id])

  @@index([studentId, examId])
  @@index([classId, sectionId, sessionId])
  @@map("mark")
}

model PromotionHistory {
  id            Int      @id @default(autoincrement())
  studentId     Int      @map("student_id")
  fromClassId   Int      @map("from_class_id")
  fromSectionId Int      @map("from_section_id")
  toClassId     Int      @map("to_class_id")
  toSectionId   Int      @map("to_section_id")
  promotedBy    Int      @map("promoted_by")
  sessionId     Int      @map("session_id")
  promotedAt    DateTime @default(now()) @map("promoted_at")

  @@index([studentId])
  @@map("promotion_history")
}

